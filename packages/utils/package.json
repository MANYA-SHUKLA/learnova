{
  "name": "@learnova/utils",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./date": {
      "types": "./dist/date/index.d.ts",
      "import": "./dist/date/index.js"
    },
    "./time": {
      "types": "./dist/time/index.d.ts",
      "import": "./dist/time/index.js"
    },
    "./pagination": {
      "types": "./dist/pagination/index.d.ts",
      "import": "./dist/pagination/index.js"
    },
    "./search": {
      "types": "./dist/search/index.d.ts",
      "import": "./dist/search/index.js"
    },
    "./uuid": {
      "types": "./dist/uuid/index.d.ts",
      "import": "./dist/uuid/index.js"
    },
    "./file": {
      "types": "./dist/file/index.d.ts",
      "import": "./dist/file/index.js"
    },
    "./encryption": {
      "types": "./dist/encryption/index.d.ts",
      "import": "./dist/encryption/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@learnova/constants": "workspace:*"
  },
  "devDependencies": {
    "@learnova/eslint-config": "workspace:*",
    "@learnova/tsconfig": "workspace:*",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  }
}
