NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

MONGODB_URI=mongodb://localhost:27017/learnova
MONGODB_DB_NAME=learnova

REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# GEMINI_API_KEY=
# JUDGE0_API_URL=http://localhost:2358
# JUDGE0_API_KEY=

# Storage (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# MAX_UPLOAD_BYTES=10485760

# Mail (console | smtp | ses)
MAIL_DRIVER=console
MAIL_FROM=noreply@learnova.local
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Feature flags (see @learnova/feature-flags)
# ENABLE_AI=false
# ENABLE_CHAT=false
# ENABLE_PROCTORING=false
# ENABLE_GPU=false
# ENABLE_CODE_RUNNER=false
# ENABLE_IDE=false
# ENABLE_ANALYTICS=true
# ENABLE_AUDIT_LOGS=true
# ENABLE_WEBHOOKS=false
