{
  "name": "@learnova/worker",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@learnova/config": "workspace:*",
    "@learnova/constants": "workspace:*",
    "@learnova/events": "workspace:*",
    "@learnova/feature-flags": "workspace:*",
    "@learnova/logger": "workspace:*",
    "@learnova/shared": "workspace:*",
    "@learnova/types": "workspace:*",
    "@learnova/utils": "workspace:*",
    "bullmq": "^5.34.8",
    "ioredis": "^5.6.1",
    "nodemailer": "^7.0.3",
    "pino": "^9.7.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@learnova/eslint-config": "workspace:*",
    "@learnova/tsconfig": "workspace:*",
    "@types/node": "^22.15.29",
    "@types/nodemailer": "^6.4.17",
    "eslint": "^9.28.0",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
