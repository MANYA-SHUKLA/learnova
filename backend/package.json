{
  "name": "@learnova/backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:local": "node --env-file=.env dist/server.js",
    "start:prod": "node dist/server.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "seed:auth": "tsx --env-file=.env src/seeds/run-auth-seed.ts",
    "seed:students": "tsx --env-file=.env src/seeds/run-student-seed.ts",
    "seed:courses": "tsx --env-file=.env src/seeds/run-course-seed.ts",
    "seed:course-builder": "tsx --env-file=.env src/seeds/run-course-builder-seed.ts",
    "seed:enrollments": "tsx --env-file=.env src/seeds/run-enrollment-seed.ts",
    "seed:enrollment-stack": "tsx --env-file=.env src/seeds/run-enrollment-stack-seed.ts",
    "seed:progress": "tsx --env-file=.env src/seeds/run-progress-seed.ts",
    "seed:assignments": "tsx --env-file=.env src/seeds/run-assignment-seed.ts",
    "seed:quizzes": "tsx --env-file=.env src/seeds/run-quiz-seed.ts",
    "seed:examinations": "tsx --env-file=.env src/seeds/run-examination-seed.ts",
    "seed:projects": "tsx --env-file=.env src/seeds/run-project-seed.ts",
    "seed:practice-labs": "tsx --env-file=.env src/seeds/run-practice-lab-seed.ts",
    "seed:practice-lab-bootstrap": "tsx --env-file=.env src/seeds/run-practice-lab-bootstrap.ts",
    "seed:gradebook": "tsx --env-file=.env src/seeds/run-gradebook-seed.ts",
    "seed:certificates": "tsx --env-file=.env src/seeds/run-certificate-seed.ts",
    "seed:demo": "tsx --env-file=.env src/seeds/run-demo-users-seed.ts",
    "seed:demo-data": "tsx --env-file=.env src/seeds/run-demo-data-seed.ts",
    "seed:demo-finalize": "tsx --env-file=.env src/seeds/run-demo-finalize-seed.ts",
    "seed:complete": "tsx --env-file=.env src/seeds/run-complete-seed.ts",
    "mail:test": "tsx --env-file=.env src/scripts/test-smtp.ts",
    "db:reset-keep-jnu": "tsx --env-file=.env src/scripts/reset-keep-jnu.ts",
    "verify:platform": "tsx --env-file=.env src/scripts/verify-platform.ts",
    "judge0:verify": "tsx --env-file=.env src/scripts/verify-judge0.ts",
    "db:indexes": "tsx --env-file=.env src/scripts/sync-indexes.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@learnova/config": "workspace:*",
    "@learnova/constants": "workspace:*",
    "@learnova/events": "workspace:*",
    "@learnova/feature-flags": "workspace:*",
    "@learnova/logger": "workspace:*",
    "@learnova/shared": "workspace:*",
    "@learnova/types": "workspace:*",
    "@learnova/utils": "workspace:*",
    "@learnova/validation": "workspace:*",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.34.8",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.1",
    "morgan": "^1.10.0",
    "nodemailer": "^7.0.3",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "rate-limit-redis": "^4.2.0",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@learnova/eslint-config": "workspace:*",
    "@learnova/tsconfig": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.29",
    "@types/nodemailer": "^6.4.17",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.28.0",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  }
}
