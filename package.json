{
  "name": "learnova",
  "version": "0.1.0",
  "private": true,
  "description": "Learnova — Enterprise AI Learning Platform",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:frontend": "turbo run dev --filter=@learnova/frontend",
    "dev:backend": "turbo run dev --filter=@learnova/backend",
    "dev:worker": "turbo run dev --filter=@learnova/worker",
    "build": "turbo run build",
    "build:frontend": "turbo run build --filter=@learnova/frontend",
    "build:backend": "turbo run build --filter=@learnova/backend",
    "build:worker": "turbo run build --filter=@learnova/worker",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "husky || true",
    "docker:dev": "docker compose -f docker/development/docker-compose.yml up --build",
    "docker:dev:down": "docker compose -f docker/development/docker-compose.yml down",
    "docker:staging": "docker compose -f docker/staging/docker-compose.yml up --build -d",
    "docker:prod": "docker compose -f docker/production/docker-compose.yml up --build -d",
    "env:check": "tsx scripts/check-env.ts",
    "verify:platform": "pnpm --filter @learnova/backend verify:platform",
    "generate:types": "turbo run generate:types --filter=@learnova/types"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@learnova/tsconfig": "workspace:*",
    "@types/node": "^22.15.29",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "thread-stream": "3.1.0"
    }
  }
}
