# Worker — multi-stage production image
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages ./packages
COPY apps/worker/package.json ./apps/worker/
RUN pnpm install --frozen-lockfile --filter @learnova/worker...

FROM base AS builder
COPY --from=deps /app /app
COPY . .
RUN pnpm --filter @learnova/types build \
 && pnpm --filter @learnova/shared build \
 && pnpm --filter @learnova/config build \
 && pnpm --filter @learnova/worker build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S learnova && adduser -S learnova -G learnova
COPY --from=builder /app/apps/worker/dist ./dist
COPY --from=builder /app/apps/worker/package.json ./
COPY --from=builder /app/node_modules ./node_modules
USER learnova
CMD ["node", "dist/index.js"]
