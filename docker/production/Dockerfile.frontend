# Frontend — multi-stage Next.js standalone image
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages ./packages
COPY frontend/package.json ./frontend/
RUN pnpm install --frozen-lockfile --filter @learnova/frontend...

FROM base AS builder
COPY --from=deps /app /app
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @learnova/types build \
 && pnpm --filter @learnova/shared build \
 && pnpm --filter @learnova/frontend build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN addgroup -S learnova && adduser -S learnova -G learnova
COPY --from=builder /app/frontend/.next/standalone ./
COPY --from=builder /app/frontend/.next/static ./frontend/.next/static
COPY --from=builder /app/frontend/public ./frontend/public
USER learnova
EXPOSE 3000
CMD ["node", "frontend/server.js"]
