# Learn more about configuring npm/pnpm for monorepos
auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
link-workspace-packages=true
shared-workspace-lockfile=true

# Hoist types/eslint so the IDE TypeScript server resolves them from the workspace root
public-hoist-pattern[]=*@types*
public-hoist-pattern[]=@learnova/tsconfig
